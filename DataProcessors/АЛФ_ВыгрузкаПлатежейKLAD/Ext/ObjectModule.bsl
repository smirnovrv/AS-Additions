
// Собирает строки расходных платежей для сверки с таблицей КЛАД.
// Одна строка — проведенное списание с расчетного счета.
// Если в расшифровке несколько строк, каждая становится отдельной строкой,
// а id получает суффикс #НомерСтроки.

#Область ПрограммныйИнтерфейс

Функция ПлатежиЗаПериод(НачалоПериода, КонецПериода, Организация, ВсеДаты = Ложь) Экспорт
	
	Данные = ДанныеПлатежей(НачалоПериода, КонецПериода, Организация, ВсеДаты);
	КоличествоПоДокументам = КоличествоСтрокПоДокументам(Данные);
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	КэшКурсов = Новый Соответствие;
	
	Платежи = НоваяТаблицаПлатежей();
	КэшОбъектов = Новый Соответствие;
	Для Каждого СтрокаДанных Из Данные Цикл
		
		НоваяСтрока = Платежи.Добавить();
		НоваяСтрока.Документ 		= СтрокаДанных.Документ;
		НоваяСтрока.НомерСтроки 	= СтрокаДанных.НомерСтроки;
		НоваяСтрока.Идентификатор 	= ИдентификаторПлатежа(
			СтрокаДанных.Документ,
			СтрокаДанных.НомерСтроки,
			КоличествоПоДокументам.Получить(СтрокаДанных.Документ));
		НоваяСтрока.ВидДокумента 		= "Списание с расчетного счета";
		НоваяСтрока.НомерДокумента 		= СокрЛП(СтрокаДанных.НомерДокумента);
		НоваяСтрока.ДатаДокумента		= НачалоДня(СтрокаДанных.ДатаДокумента);
		НоваяСтрока.Организация 		= СтрокаДанных.Организация;
		НоваяСтрока.ОбъектСтроительства = НаименованиеОбъекта(СтрокаДанных.Проект, КэшОбъектов);
		НоваяСтрока.Контрагент 			= СтрокаДанных.Контрагент;
		НоваяСтрока.Договор 			= СтрокаДанных.Договор;
		НоваяСтрока.НазначениеПлатежа 	= СтрокаДанных.НазначениеПлатежа;
		НоваяСтрока.ТипПлатежа 			= ТекстТипаПлатежа(СтрокаДанных.ТипПлатежа);
		НоваяСтрока.Сумма = СуммаВРублях(
			СтрокаДанных.Сумма,
			СтрокаДанных.Валюта,
			СтрокаДанных.ДатаДокумента,
			ВалютаРегламентированногоУчета,
			КэшКурсов);
		НоваяСтрока.Статус 			= СтатусПлатежа(СтрокаДанных.Статус);
		НоваяСтрока.ДатаПроводки 	= НачалоДня(СтрокаДанных.ДатаДокумента);
		//НоваяСтрока.Очередь 		= ОчередьПлатежа(СтрокаДанных.Договор, СтрокаДанных.ПроектДляОчереди);   
		НоваяСтрока.Очередь 		= ""; //Заглушка
		НоваяСтрока.СтатьяБюджета 	= СтрокаДанных.СтатьяБюджета;
		НоваяСтрока.Описание 		= СтрокаДанных.Описание;
		НоваяСтрока.Валюта 			= СтрокаДанных.ВалютаНаименование;
		
	КонецЦикла;
	
	Возврат Платежи;
	
КонецФункции

// Отправляет строки таблицы формы на https://klad.acons.space/api/klad1c.
// Сеанс: ping, begin, rows по периодам из need, commit.
// ПробныйЗапуск добавляет dryRun в commit: сервер проверяет снимок и не применяет его.
// В снимок попадают только переданные строки. Период, которого среди них нет, сервер удаляет.
//
// Возвращаемое значение:
//  Структура - Успех, Текст.
//
Функция ОтправитьРеестр(ПробныйЗапуск, Платежи) Экспорт
	
	Попытка
		Возврат ОтправитьРеестрВнутр(ПробныйЗапуск, Платежи);
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписатьСобытиеОтправки(УровеньЖурналаРегистрации.Ошибка, ПодробноеПредставлениеОшибки(Информация));
		Возврат РезультатОтправки(Ложь, КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;
	
КонецФункции

Функция КлючДоступаЗадан() Экспорт
	
	Возврат ЗначениеЗаполнено(ПрочитатьКлючДоступа());
	
КонецФункции

// Сохраняет ключ в безопасном хранилище. Пустая строка в результате — ключ записан.
Функция СохранитьКлючДоступа(Ключ) Экспорт
	
	Ключ = СокрЛП(Ключ);
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат "Введите ключ доступа.";
	КонецЕсли;
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецКлюча(), Ключ, "ApiKey");
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Возврат "Не удалось записать ключ в безопасное хранилище.";
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеПлатежей(НачалоПериода, КонецПериода, Организация, ВсеДаты = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Списание.Ссылка КАК Документ,
	|	Списание.Номер КАК НомерДокумента,
	|	Списание.Дата КАК ДатаДокумента,
	|	ЕСТЬNULL(Списание.Организация.Наименование, """") КАК Организация,
	|	ВЫБОР
	|		КОГДА Расшифровка.НомерСтроки ЕСТЬ НЕ NULL
	|				И Расшифровка.Проект <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	|			ТОГДА Расшифровка.Проект
	|		ИНАЧЕ Списание.Проект
	|	КОНЕЦ КАК Проект,
	|	ЕСТЬNULL(Списание.Контрагент.Наименование, """") КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Расшифровка.НомерСтроки ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(Списание.ДоговорКонтрагента.Наименование, """")
	|		КОГДА Расшифровка.ДоговорКонтрагента = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Списание.ДоговорКонтрагента.Наименование, """")
	|		ИНАЧЕ ЕСТЬNULL(Расшифровка.ДоговорКонтрагента.Наименование, """")
	|	КОНЕЦ КАК Договор,
	|	ВЫБОР
	|		КОГДА Расшифровка.НомерСтроки ЕСТЬ НЕ NULL
	|				И Расшифровка.Проект <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Расшифровка.Проект.Наименование, """")
	|		КОГДА Списание.Проект <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Списание.Проект.Наименование, """")
	|		ИНАЧЕ ЕСТЬNULL(Списание.ИИТ_ОбъектСтроительства.Наименование, """")
	|	КОНЕЦ КАК ПроектДляОчереди,
	|	ЕСТЬNULL(Списание.НазначениеПлатежа, """") КАК НазначениеПлатежа,
	|	ВЫБОР
	|		КОГДА ЗаявкаСтроки.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА ЗаявкаСтроки.ИИТ_ТипПлатежа
	|		ИНАЧЕ ЗаявкаШапки.ИИТ_ТипПлатежа
	|	КОНЕЦ КАК ТипПлатежа,
	|	ВЫБОР
	|		КОГДА Расшифровка.НомерСтроки ЕСТЬ NULL
	|			ТОГДА Списание.СуммаДокумента
	|		ИНАЧЕ Расшифровка.СуммаПлатежа
	|	КОНЕЦ КАК Сумма,
	|	ПРЕДСТАВЛЕНИЕ(Состояния.Состояние) КАК Статус,
	|	ВЫБОР
	|		КОГДА Расшифровка.НомерСтроки ЕСТЬ НЕ NULL
	|				И Расшифровка.СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Расшифровка.СтатьяДвиженияДенежныхСредств.Наименование, """")
	|		КОГДА Списание.СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Списание.СтатьяДвиженияДенежныхСредств.Наименование, """")
	|		КОГДА ЗаявкаСтроки.Ссылка ЕСТЬ НЕ NULL
	|				И ЗаявкаСтроки.ИИТ_СтатьяДДСОсновная <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ЗаявкаСтроки.ИИТ_СтатьяДДСОсновная.Наименование, """")
	|		ИНАЧЕ ЕСТЬNULL(ЗаявкаШапки.ИИТ_СтатьяДДСОсновная.Наименование, """")
	|	КОНЕЦ КАК СтатьяБюджета,
	|	ВЫБОР
	|		КОГДА ЗаявкаСтроки.Ссылка ЕСТЬ НЕ NULL
	|			ТОГДА ЕСТЬNULL(ЗаявкаСтроки.ИИТ_ОписаниеЗаявки, """")
	|		ИНАЧЕ ЕСТЬNULL(ЗаявкаШапки.ИИТ_ОписаниеЗаявки, """")
	|	КОНЕЦ КАК Описание,
	|	ЕСТЬNULL(Расшифровка.НомерСтроки, 0) КАК НомерСтроки,
	|	Списание.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Списание.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование
	|ИЗ
	|	Документ.СписаниеСРасчетногоСчета КАК Списание
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеСРасчетногоСчета.РасшифровкаПлатежа КАК Расшифровка
	|		ПО Списание.Ссылка = Расшифровка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаСтроки
	|		ПО Расшифровка.ДокументПланирования = ЗаявкаСтроки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаШапки
	|		ПО Списание.ДокументПланирования = ЗаявкаШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежноеПоручение КАК Поручение
	|		ПО Списание.ДокументОснование = Поручение.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияБанковскихДокументов КАК Состояния
	|		ПО Поручение.Ссылка = Состояния.СсылкаНаОбъект
	|			И Поручение.Организация = Состояния.Организация
	|ГДЕ
	|	(&ВсеДаты
	|			ИЛИ Списание.Дата МЕЖДУ &НачалоПериода И &КонецПериода)
	|	И Списание.Проведен
	|	И НЕ Списание.ПометкаУдаления
	|	И (&ВсеОрганизации
	|			ИЛИ Списание.Организация = &Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокумента,
	|	НомерДокумента,
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ВсеДаты", ВсеДаты);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Организация));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КоличествоСтрокПоДокументам(Данные)
	
	КоличествоПоДокументам = Новый Соответствие;
	Для Каждого СтрокаДанных Из Данные Цикл
		Количество = КоличествоПоДокументам.Получить(СтрокаДанных.Документ);
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;
		КоличествоПоДокументам.Вставить(СтрокаДанных.Документ, Количество + 1);
	КонецЦикла;
	
	Возврат КоличествоПоДокументам;
	
КонецФункции

Функция НоваяТаблицаПлатежей()
	
	Платежи = Новый ТаблицаЗначений;
	Платежи.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.СписаниеСРасчетногоСчета"));
	Платежи.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	Платежи.Колонки.Добавить("Идентификатор", ОписаниеСтроки());
	Платежи.Колонки.Добавить("ВидДокумента", ОписаниеСтроки());
	Платежи.Колонки.Добавить("НомерДокумента", ОписаниеСтроки());
	Платежи.Колонки.Добавить("ДатаДокумента", ОписаниеДаты());
	Платежи.Колонки.Добавить("Организация", ОписаниеСтроки());
	Платежи.Колонки.Добавить("ОбъектСтроительства", ОписаниеСтроки());
	Платежи.Колонки.Добавить("Контрагент", ОписаниеСтроки());
	Платежи.Колонки.Добавить("Договор", ОписаниеСтроки());
	Платежи.Колонки.Добавить("НазначениеПлатежа", ОписаниеСтроки());
	Платежи.Колонки.Добавить("ТипПлатежа", ОписаниеСтроки());
	Платежи.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Платежи.Колонки.Добавить("Статус", ОписаниеСтроки());
	Платежи.Колонки.Добавить("ДатаПроводки", ОписаниеДаты());
	Платежи.Колонки.Добавить("Очередь", ОписаниеСтроки());
	Платежи.Колонки.Добавить("СтатьяБюджета", ОписаниеСтроки());
	Платежи.Колонки.Добавить("Описание", ОписаниеСтроки());
	Платежи.Колонки.Добавить("Валюта", ОписаниеСтроки());
	
	Возврат Платежи;
	
КонецФункции

Функция НаименованиеОбъекта(Проект, КэшОбъектов)
	
	Если Не ЗначениеЗаполнено(Проект) Тогда
		Возврат "";
	КонецЕсли;
	
	Наименование = КэшОбъектов.Получить(Проект);
	Если Наименование <> Неопределено Тогда
		Возврат Наименование;
	КонецЕсли;
	
	Объект = ИИТ_ВспомогательныеФункцииСервер.МаксимальныйУровеньСправочника(Проект);
	Если ЗначениеЗаполнено(Объект) Тогда
		Наименование = СокрЛП(Объект.Наименование);
	Иначе
		Наименование = "";
	КонецЕсли;
	КэшОбъектов.Вставить(Проект, Наименование);
	
	Возврат Наименование;
	
КонецФункции

Функция ОписаниеСтроки()
	
	Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0));
	
КонецФункции

Функция ОписаниеДаты()
	
	Возврат Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	
КонецФункции

Функция ИдентификаторПлатежа(Документ, НомерСтроки, КоличествоСтрок)
	
	Идентификатор = XMLСтрока(Документ.УникальныйИдентификатор());
	Если КоличествоСтрок > 1 Тогда
		Идентификатор = Идентификатор + "#" + Формат(НомерСтроки, "ЧГ=0");
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

Функция ТекстТипаПлатежа(ТипПлатежа)
	
	Если ТипПлатежа = Перечисления.ИИТ_ТипПлатежаВЗаявке.Аванс Тогда
		Возврат "Аванс";
	ИначеЕсли ТипПлатежа = Перечисления.ИИТ_ТипПлатежаВЗаявке.ОплатаЗаВыполненныеРаботы Тогда
		Возврат "Оплата за выполн. работы";
	ИначеЕсли ТипПлатежа = Перечисления.ИИТ_ТипПлатежаВЗаявке.ГУ Тогда
		Возврат "ГУ";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СтатусПлатежа(Статус)
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат "Оплачено";
	КонецЕсли;
	
	Возврат СокрЛП(Статус);
	
КонецФункции

Функция ОчередьПлатежа(Договор, Проект)
	
	Очередь = ФрагментОчереди(Договор);
	Если ПустаяСтрока(Очередь) Тогда
		Очередь = ФрагментОчереди(Проект);
	КонецЕсли;
	
	Возврат Очередь;
	
КонецФункции

Функция ФрагментОчереди(Текст)
	
	ИсходныйТекст = ВРег(СокрЛП(Текст));
	ПозицияПоиска = 1;
	ДлинаТекста = СтрДлина(ИсходныйТекст);
	Пока ПозицияПоиска <= ДлинаТекста Цикл
		Позиция = СтрНайти(ИсходныйТекст, "СБ", , ПозицияПоиска);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Цифры = "";
		Индекс = Позиция + 2;
		Пока Индекс <= ДлинаТекста Цикл
			Символ = Сред(ИсходныйТекст, Индекс, 1);
			Если Символ >= "0" И Символ <= "9" Тогда
				Цифры = Цифры + Символ;
				Индекс = Индекс + 1;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ПустаяСтрока(Цифры) Тогда
			Возврат "СБ" + Цифры;
		КонецЕсли;
		
		ПозицияПоиска = Позиция + 2;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция СуммаВРублях(Сумма, Валюта, ДатаКурса, ВалютаРегламентированногоУчета, КэшКурсов)
	
	Если Не ЗначениеЗаполнено(Валюта) Или Валюта = ВалютаРегламентированногоУчета Тогда
		Возврат Окр(Сумма, 2);
	КонецЕсли;
	
	КлючКурса = XMLСтрока(Валюта) + Формат(ДатаКурса, "ДФ=yyyyMMdd");
	КурсВалюты = КэшКурсов.Получить(КлючКурса);
	Если КурсВалюты = Неопределено Тогда
		КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ДатаКурса);
		КэшКурсов.Вставить(КлючКурса, КурсВалюты);
	КонецЕсли;
	
	Если КурсВалюты.Кратность = 0 Тогда
		Возврат Окр(Сумма, 2);
	КонецЕсли;
	
	Возврат Окр(Сумма * КурсВалюты.Курс / КурсВалюты.Кратность, 2);
	
КонецФункции

Функция ОтправитьРеестрВнутр(ПробныйЗапуск, Платежи)
	
	Ключ = ПрочитатьКлючДоступа();
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Текст = "Ключ доступа не сохранён. Введите его на форме и нажмите «Сохранить ключ».";
		ЗаписатьСобытиеОтправки(УровеньЖурналаРегистрации.Ошибка, Текст);
		Возврат РезультатОтправки(Ложь, Текст);
	КонецЕсли;
	
	Если Платежи = Неопределено Или Платежи.Количество() = 0 Тогда
		Текст = "Таблица пуста. Отправка отменена, чтобы сервер не удалил ранее принятые строки.";
		ЗаписатьСобытиеОтправки(УровеньЖурналаРегистрации.Ошибка, Текст);
		Возврат РезультатОтправки(Ложь, Текст);
	КонецЕсли;
	
	Пакет = ПакетРеестра(Платежи);
	Для НомерПопытки = 1 По 3 Цикл
		Результат = ВыполнитьСеанс(Ключ, Пакет, ПробныйЗапуск);
		Если Результат.Успех Тогда
			ЗаписатьСобытиеОтправки(УровеньЖурналаРегистрации.Информация, Результат.Текст);
			Возврат Результат;
		КонецЕсли;
		
		ЗаписатьСобытиеОтправки(
			УровеньЖурналаРегистрации.Ошибка,
			"Попытка " + Формат(НомерПопытки, "ЧГ=0") + ". " + Результат.Текст);
		Если Не Результат.ПовторятьСеанс Или НомерПопытки = 3 Тогда
			Возврат Результат;
		КонецЕсли;
		
		Пауза(60);
	КонецЦикла;
	
	Возврат РезультатОтправки(Ложь, "Отправка не выполнена.");
	
КонецФункции

Функция ПакетРеестра(Платежи)
	
	Платежи.Колонки.Добавить("Период", ОписаниеСтроки());
	Для Каждого СтрокаПлатежа Из Платежи Цикл
		СтрокаПлатежа.Период = ПериодПлатежа(СтрокаПлатежа.ДатаПроводки);
	КонецЦикла;
	Платежи.Сортировать("Период, Идентификатор");
	
	Описания = Новый Массив;
	СтрокиПериодов = Новый Соответствие;
	ТекущийПериод = Неопределено;
	СтрокиПериода = Неопределено;
	СуммаПериода = 0;
	ТекстХеша = Новый Массив;
	
	Для Каждого СтрокаПлатежа Из Платежи Цикл
		Если СтрокаПлатежа.Период <> ТекущийПериод Тогда
			Если ТекущийПериод <> Неопределено Тогда
				Описания.Добавить(ОписаниеПериода(ТекущийПериод, СтрокиПериода.Количество(), СуммаПериода, ТекстХеша));
			КонецЕсли;
			ТекущийПериод = СтрокаПлатежа.Период;
			СтрокиПериода = Новый Массив;
			СтрокиПериодов.Вставить(ТекущийПериод, СтрокиПериода);
			СуммаПериода = 0;
			ТекстХеша = Новый Массив;
		КонецЕсли;
		
		СтрокиПериода.Добавить(СтрокаПлатежа);
		СуммаПериода = СуммаПериода + СтрокаПлатежа.Сумма;
		ТекстХеша.Добавить(СтрокаХеша(СтрокаПлатежа));
	КонецЦикла;
	
	Если ТекущийПериод <> Неопределено Тогда
		Описания.Добавить(ОписаниеПериода(ТекущийПериод, СтрокиПериода.Количество(), СуммаПериода, ТекстХеша));
	КонецЕсли;
	
	Пакет = Новый Структура;
	Пакет.Вставить("Описания", Описания);
	Пакет.Вставить("СтрокиПериодов", СтрокиПериодов);
	Пакет.Вставить("КоличествоСтрок", Платежи.Количество());
	Возврат Пакет;
	
КонецФункции

Функция ОписаниеПериода(Период, Количество, Сумма, СтрокиХеша)
	
	Описание = Новый Структура;
	Описание.Вставить("Период", Период);
	Описание.Вставить("Количество", Количество);
	Описание.Вставить("Сумма", Окр(Сумма, 2));
	Описание.Вставить("Хеш", ХешMD5(СтрСоединить(СтрокиХеша, Символы.ПС)));
	Возврат Описание;
	
КонецФункции

Функция СтрокаХеша(СтрокаПлатежа)
	
	Поля = Новый Массив;
	Поля.Добавить(СтрокаПлатежа.Идентификатор);
	Поля.Добавить(ДатаJSON(СтрокаПлатежа.ДатаПроводки));
	Поля.Добавить(Формат(СтрокаПлатежа.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
	Поля.Добавить(СтрокаПлатежа.Договор);
	Поля.Добавить(СтрокаПлатежа.ТипПлатежа);
	Поля.Добавить(СтрокаПлатежа.Контрагент);
	Поля.Добавить(СтрокаПлатежа.НазначениеПлатежа);
	Поля.Добавить(СтрокаПлатежа.Статус);
	Поля.Добавить(СтрокаПлатежа.Очередь);
	Поля.Добавить(СтрокаПлатежа.СтатьяБюджета);
	Поля.Добавить(СтрокаПлатежа.Описание);
	
	Возврат СтрСоединить(Поля, "|");
	
КонецФункции

Функция ХешMD5(Текст)
	
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Текст);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	
КонецФункции

Функция ВыполнитьСеанс(Ключ, Пакет, ПробныйЗапуск)
	
	Соединение = НовоеСоединение();
	Результат = ВызватьСервис(Соединение, "", ТекстДействия("ping"), "ping");
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;
	
	Момент = ТекущаяДатаСеанса();
	МоментТекст = Формат(Момент, "ДФ=yyyy-MM-dd") + "T" + Формат(Момент, "ДФ=HH:mm:ss");
	Результат = ВызватьСервис(Соединение, Ключ, ТекстНачала(Пакет.Описания, МоментТекст), "begin");
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИдентификаторПакета = ТекстПоля(Результат.Данные, "batchId");
	Если ПустаяСтрока(ИдентификаторПакета) Тогда
		Возврат РезультатОтправки(Ложь, "begin: в ответе нет batchId.");
	КонецЕсли;
	
	НужныеПериоды = СписокСтрок(Результат.Данные.Получить("need"));
	Если НужныеПериоды = Неопределено Тогда
		Возврат РезультатОтправки(Ложь, "begin: в ответе нет списка need.");
	КонецЕсли;
	
	Для Каждого Период Из НужныеПериоды Цикл
		СтрокиПериода = Пакет.СтрокиПериодов.Получить(Период);
		Если СтрокиПериода = Неопределено Тогда
			Возврат РезультатОтправки(Ложь, "Сервер запросил период " + Период + ", которого нет в снимке.");
		КонецЕсли;
		
		Результат = ОтправитьПериод(Соединение, Ключ, ИдентификаторПакета, Период, СтрокиПериода, 2000);
		Если Не Результат.Успех Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Результат = ВызватьСервис(
		Соединение,
		Ключ,
		ТекстЗавершения(ИдентификаторПакета, ПробныйЗапуск),
		"commit");
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Текст = ТекстУспеха(Результат.Данные, Пакет, НужныеПериоды, ПробныйЗапуск);
	Возврат Результат;
	
КонецФункции

Функция ОтправитьПериод(Соединение, Ключ, ИдентификаторПакета, Период, СтрокиПериода, РазмерЧасти)
	
	Части = ЧастиСтрок(СтрокиПериода, РазмерЧасти);
	ВсегоЧастей = Части.Количество();
	Для НомерЧасти = 1 По ВсегоЧастей Цикл
		Часть = Части[НомерЧасти - 1];
		Тело = ТекстСтрок(ИдентификаторПакета, Период, Часть, НомерЧасти, ВсегоЧастей);
		// Повтор периода заменяет уже присланное, поэтому при слишком большом теле
		// заново уходит весь период более мелкими частями.
		Если СтрДлина(Тело) > 3000000 И РазмерЧасти > 1 Тогда
			Возврат ОтправитьПериод(
				Соединение,
				Ключ,
				ИдентификаторПакета,
				Период,
				СтрокиПериода,
				Цел(РазмерЧасти / 2));
		КонецЕсли;
		
		Действие = "rows " + Период;
		Если ВсегоЧастей > 1 Тогда
			Действие = Действие + ", часть " + Формат(НомерЧасти, "ЧГ=0");
		КонецЕсли;
		Результат = ВызватьСервис(Соединение, Ключ, Тело, Действие);
		Если Не Результат.Успех И СтрНайти(Результат.Текст, "HTTP 413") > 0 И РазмерЧасти > 1 Тогда
			Возврат ОтправитьПериод(
				Соединение,
				Ключ,
				ИдентификаторПакета,
				Период,
				СтрокиПериода,
				Цел(РазмерЧасти / 2));
		КонецЕсли;
		Если Не Результат.Успех Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатОтправки(Истина, "");
	
КонецФункции

Функция ЧастиСтрок(Строки, РазмерЧасти)
	
	Части = Новый Массив;
	Индекс = 0;
	Пока Индекс < Строки.Количество() Цикл
		Часть = Новый Массив;
		Пока Индекс < Строки.Количество() И Часть.Количество() < РазмерЧасти Цикл
			Часть.Добавить(Строки[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		Части.Добавить(Часть);
	КонецЦикла;
	
	Возврат Части;
	
КонецФункции

Функция ВызватьСервис(Соединение, Ключ, Тело, Действие)
	
	ПопытокПревышения = 0;
	Пока Истина Цикл
		Запрос = Новый HTTPЗапрос("/api/klad1c");
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Если ЗначениеЗаполнено(Ключ) Тогда
			Запрос.Заголовки.Вставить("X-Api-Key", Ключ);
		КонецЕсли;
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
		Попытка
			Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		Исключение
			Возврат РезультатОтправки(
				Ложь,
				Действие + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
				Истина);
		КонецПопытки;
		
		Код = Ответ.КодСостояния;
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если Код = 429 Тогда
			ПопытокПревышения = ПопытокПревышения + 1;
			Если ПопытокПревышения >= 3 Тогда
				Возврат РезультатОтправки(Ложь, Действие + ": HTTP 429. " + Лев(ТелоОтвета, 2000));
			КонецЕсли;
			Пауза(60);
			Продолжить;
		КонецЕсли;
		
		Если Код >= 500 Тогда
			Возврат РезультатОтправки(
				Ложь,
				Действие + ": HTTP " + Формат(Код, "ЧГ=0") + ". " + Лев(ТелоОтвета, 2000),
				Истина);
		КонецЕсли;
		
		Если Код <> 200 Тогда
			Возврат РезультатОтправки(
				Ложь,
				Действие + ": HTTP " + Формат(Код, "ЧГ=0") + ". " + Лев(ТелоОтвета, 2000));
		КонецЕсли;
		
		Данные = РазобратьОтвет(ТелоОтвета);
		Если Данные = Неопределено Тогда
			Возврат РезультатОтправки(Ложь, Действие + ": ответ не JSON. " + Лев(ТелоОтвета, 2000), Истина);
		КонецЕсли;
		
		Если Данные.Получить("ok") <> Истина Тогда
			Возврат РезультатОтправки(Ложь, ТекстОтказа(Действие, Данные), Ложь, Данные);
		КонецЕсли;
		
		Возврат РезультатОтправки(Истина, "", Ложь, Данные);
	КонецЦикла;
	
КонецФункции

