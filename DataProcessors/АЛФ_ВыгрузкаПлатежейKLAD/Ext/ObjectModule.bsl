Функция ТекстСтрок(ИдентификаторПакета, Период, Строки, НомерЧасти, ВсегоЧастей)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПолеJSON(Запись, "action", "rows");
	ЗаписатьПолеJSON(Запись, "batchId", ИдентификаторПакета);
	ЗаписатьПолеJSON(Запись, "period", Период);
	Если ВсегоЧастей > 1 Тогда
		ЗаписатьПолеJSON(Запись, "part", НомерЧасти);
		ЗаписатьПолеJSON(Запись, "parts", ВсегоЧастей);
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("rows");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого СтрокаПлатежа Из Строки Цикл
		Запись.ЗаписатьНачалоОбъекта();
		ЗаписатьПолеJSON(Запись, "id", СтрокаПлатежа.Идентификатор);
		ЗаписатьПолеJSON(Запись, "docType", СтрокаПлатежа.ВидДокумента);
		ЗаписатьПолеJSON(Запись, "docNumber", СтрокаПлатежа.НомерДокумента);
		ЗаписатьПолеJSON(Запись, "docDate", ДатаJSON(СтрокаПлатежа.ДатаДокумента));
		ЗаписатьПолеJSON(Запись, "org", СтрокаПлатежа.Организация);
		ЗаписатьПолеJSON(Запись, "object", СтрокаПлатежа.ОбъектСтроительства);
		ЗаписатьПолеJSON(Запись, "counterparty", СтрокаПлатежа.Контрагент);
		ЗаписатьПолеJSON(Запись, "contract", СтрокаПлатежа.Договор);
		ЗаписатьПолеJSON(Запись, "purpose", СтрокаПлатежа.НазначениеПлатежа);
		ЗаписатьПолеJSON(Запись, "payType", СтрокаПлатежа.ТипПлатежа);
		ЗаписатьПолеJSON(Запись, "amount", Окр(СтрокаПлатежа.Сумма, 2));
		ЗаписатьПолеJSON(Запись, "status", СтрокаПлатежа.Статус);
		ЗаписатьПолеJSON(Запись, "date", ДатаJSON(СтрокаПлатежа.ДатаПроводки));
		ЗаписатьПолеJSON(Запись, "queue", СтрокаПлатежа.Очередь);
		ЗаписатьПолеJSON(Запись, "budgetItem", СтрокаПлатежа.СтатьяБюджета);
		ЗаписатьПолеJSON(Запись, "description", СтрокаПлатежа.Описание);
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ТекстЗавершения(ИдентификаторПакета, ПробныйЗапуск)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПолеJSON(Запись, "action", "commit");
	ЗаписатьПолеJSON(Запись, "batchId", ИдентификаторПакета);
	Если ПробныйЗапуск Тогда
		ЗаписатьПолеJSON(Запись, "dryRun", Истина);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
	
КонецФункции

Процедура ЗаписатьПолеJSON(Запись, Имя, Значение)
	
	Запись.ЗаписатьИмяСвойства(Имя);
	Запись.ЗаписатьЗначение(Значение);
	
КонецПроцедуры

Функция РазобратьОтвет(Текст)
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция ТекстОтказа(Действие, Данные)
	
	Возврат Действие + ": " + ТекстПоля(Данные, "error") + ". " + ТекстПоля(Данные, "message");
	
КонецФункции

Функция ТекстУспеха(Данные, Пакет, НужныеПериоды, ПробныйЗапуск)
	
	Если ПробныйЗапуск Тогда
		Текст = "Пробный запуск выполнен, снимок на сервере не применён.";
	Иначе
		Текст = "Снимок применён.";
	КонецЕсли;
	
	Текст = Текст
		+ " Версия: " + ТекстЧислаОтвета(Данные, "version")
		+ ", периодов обновлено: " + ТекстЧислаОтвета(Данные, "periodsUpdated")
		+ ", строк в ответе: " + ТекстЧислаОтвета(Данные, "rowsTotal")
		+ ". В снимке строк: " + Формат(Пакет.КоличествоСтрок, "ЧГ=0")
		+ ", периодов: " + Формат(Пакет.Описания.Количество(), "ЧГ=0")
		+ ", сервер запросил: " + ПереченьПериодов(НужныеПериоды)
		+ ".";
	
	Возврат Текст + ТекстПредупреждений(Данные);
	
КонецФункции

Функция ПереченьПериодов(Периоды)
	
	Если Периоды.Количество() = 0 Тогда
		Возврат "ни одного периода";
	КонецЕсли;
	
	Если Периоды.Количество() <= 12 Тогда
		Возврат СтрСоединить(Периоды, ", ");
	КонецЕсли;
	
	Возврат Формат(Периоды.Количество(), "ЧГ=0") + " периодов";
	
КонецФункции

Функция ТекстПредупреждений(Данные)
	
	Значение = Данные.Получить("warnings");
	Если ТипЗнч(Значение) <> Тип("Массив") Или Значение.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") И Не ПустаяСтрока(Элемент) Тогда
			Части.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Если Части.Количество() = 0 Тогда
		Возврат " Предупреждений: " + Формат(Значение.Количество(), "ЧГ=0") + ".";
	КонецЕсли;
	
	Возврат " Предупреждения: " + СтрСоединить(Части, "; ") + ".";
	
КонецФункции

Функция ТекстЧислаОтвета(Данные, Имя)
	
	Значение = Данные.Получить(Имя);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧДЦ=0");
	КонецЕсли;
	
	Возврат "не указано";
	
КонецФункции

Функция ТекстПоля(Данные, Имя)
	
	Значение = Данные.Получить(Имя);
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СписокСтрок(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Список = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Список.Добавить(СокрЛП(Строка(Элемент)));
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции

Функция ПериодПлатежа(ДатаПлатежа)
	
	Если Не ЗначениеЗаполнено(ДатаПлатежа) Тогда
		Возврат "0000-00";
	КонецЕсли;
	
	Возврат Формат(ДатаПлатежа, "ДФ=yyyy-MM");
	
КонецФункции

Функция ДатаJSON(ДатаПлатежа)
	
	Если Не ЗначениеЗаполнено(ДатаПлатежа) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Формат(ДатаПлатежа, "ДФ=yyyy-MM-dd");
	
КонецФункции

Функция ПрочитатьКлючДоступа()
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецКлюча(), "ApiKey");
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Возврат "";
	КонецПопытки;
	
	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Ключ);
	
КонецФункции

Функция ВладелецКлюча()
	
	Возврат "АЛФ_ВыгрузкаПлатежейKLAD";
	
КонецФункции

Функция РезультатОтправки(Успех, Текст, ПовторятьСеанс = Ложь, Данные = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Успех);
	Результат.Вставить("Текст", Текст);
	Результат.Вставить("ПовторятьСеанс", ПовторятьСеанс);
	Результат.Вставить("Данные", Данные);
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьСобытиеОтправки(Уровень, Текст)
	
	ЗаписьЖурналаРегистрации(
		"АЛФ.Выгрузка платежей в КЛАД",
		Уровень,
		Метаданные.Обработки.АЛФ_ВыгрузкаПлатежейKLAD,
		,
		Лев(Текст, 8000));
	
КонецПроцедуры

Процедура Пауза(Секунды)
	
	Если Секунды <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Оболочка = Новый COMОбъект("WScript.Shell");
		Оболочка.Run("ping -n " + Формат(Секунды + 1, "ЧГ=0") + " 127.0.0.1", 0, Истина);
	Исключение
		ЗаписатьСобытиеОтправки(
			УровеньЖурналаРегистрации.Предупреждение,
			"Пауза перед повтором не выполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
