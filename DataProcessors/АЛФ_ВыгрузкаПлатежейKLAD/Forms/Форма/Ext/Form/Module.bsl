
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода = КонецМесяца(ТекущаяДатаСеанса());
	ОбновитьНадписьКоличества();
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		ПоказатьПредупреждение(, "Укажите начало и конец периода.");
		Возврат;
	КонецЕсли;
	
	Если НачалоПериода > КонецПериода Тогда
		ПоказатьПредупреждение(, "Начало периода больше конца периода.");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Платежи.Загрузить(Обработка.ПлатежиЗаПериод(НачалоПериода, КонецПериода, Организация));
	ОбновитьНадписьКоличества();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьКоличества()
	
	Элементы.НадписьКоличество.Заголовок = "Строк: " + Формат(Платежи.Количество(), "ЧГ=0");
	
КонецПроцедуры
