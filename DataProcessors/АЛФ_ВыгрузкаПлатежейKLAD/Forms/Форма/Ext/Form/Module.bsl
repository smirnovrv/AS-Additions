
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	ПробныйЗапуск = Истина;
	ОбновитьНадписьКоличества();
	ОбновитьНадписьКлюча();
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Или Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите начало и конец периода.");
		Возврат;
	КонецЕсли;
	
	Если Период.ДатаНачала > Период.ДатаОкончания Тогда
		ПоказатьПредупреждение(, "Начало периода больше конца периода.");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Платежи.Загрузить(Обработка.ПлатежиЗаПериод(Период.ДатаНачала, Период.ДатаОкончания, Организация));
	ОбновитьНадписьКоличества();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьКоличества()
	
	Элементы.НадписьКоличество.Заголовок = "Строк: " + Формат(Платежи.Количество(), "ЧГ=0");
	
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	
	Если Платежи.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица пуста. Сначала заполните строки.");
		Возврат;
	КонецЕсли;
	
	ТекстКоличества = "Будут отправлены строки из таблицы: " + Формат(Платежи.Количество(), "ЧГ=0") + ".";
	Если ПробныйЗапуск Тогда
		Текст = ТекстКоличества + " Пробный запуск: сервер проверит снимок и не применит его.";
	Иначе
		Текст = ТекстКоличества + " Снимок будет применён на сервере КЛАД. Периоды, которых нет в таблице, сервер удалит у себя.";
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОтправитьПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПредупреждение(, ОтправитьНаСервере());
	
КонецПроцедуры

&НаСервере
Функция ОтправитьНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ОтправитьРеестр(ПробныйЗапуск, Платежи.Выгрузить());
	Возврат Результат.Текст;
	
КонецФункции

&НаКлиенте
Процедура СохранитьКлюч(Команда)
	
	Текст = СохранитьКлючНаСервере();
	Если ЗначениеЗаполнено(Текст) Тогда
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СохранитьКлючНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Текст = Обработка.СохранитьКлючДоступа(КлючДоступа);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		КлючДоступа = "";
	КонецЕсли;
	ОбновитьНадписьКлюча();
	Возврат Текст;
	
КонецФункции

&НаСервере
Процедура ОбновитьНадписьКлюча()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Если Обработка.КлючДоступаЗадан() Тогда
		Элементы.НадписьКлюч.Заголовок = "Ключ доступа сохранён";
	Иначе
		Элементы.НадписьКлюч.Заголовок = "Ключ доступа не сохранён";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПлатежиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя <> "ПлатежиДокумент" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Платежи.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ТекущиеДанные.Документ);
	
КонецПроцедуры
