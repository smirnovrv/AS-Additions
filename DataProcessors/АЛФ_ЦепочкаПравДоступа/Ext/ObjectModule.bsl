///////////////////////////////////////////////////////////////////////////////////////////////////////
// Обработка АЛФ_ЦепочкаПравДоступа
//
// Назначение:
//   Построение цепочки «Объект метаданных → Роль → Профиль → Группа доступа → Пользователь».
//
// Источники данных (как в типовом отчёте «Анализ прав доступа» БСП):
//   1. РегистрСведений.ПраваРолей — объект ↔ роль (наличие строки = право «Чтение»).
//   2. УправлениеДоступомСлужебный.ПраваРолейРасширений() — права ролей расширений.
//   3. Справочник.ПрофилиГруппДоступа.Роли — роль ↔ профиль.
//   4. Справочник.ГруппыДоступа — группа ↔ профиль.
//   5. Справочник.ГруппыДоступа.Пользователи + РегистрСведений.СоставыГруппПользователей —
//      участники группы доступа с разворотом групп пользователей.
//
// Что считается «осмысленным правом»:
//   В выборку попадают строки, где роль даёт право «Чтение» на объект
//   (в РС.ПраваРолей это эквивалентно наличию записи; дополнительно выводятся флаги
//   Изменение / Добавление / Просмотр / Редактирование).
//
// Ограничения:
//   - Не анализирует RLS по значениям видов доступа (организации, проекты и т.п.).
//   - Не показывает права на отдельные реквизиты, команды, формы, отчёты без таблицы.
//   - Не учитывает полноправных пользователей без групп доступа (роль ПолныеПрава напрямую).
//   - Без отбора по объекту или пользователю формирование запрещено (объём данных огромен).
//
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает таблицу цепочек прав по заданным отборам.
//
// Параметры:
//  Отборы - Структура:
//    * ОбъектМетаданных - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//                         СправочникСсылка.ИдентификаторыОбъектовРасширений, Неопределено
//    * Роль             - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//                         СправочникСсылка.ИдентификаторыОбъектовРасширений, Неопределено
//    * Профиль          - СправочникСсылка.ПрофилиГруппДоступа, Неопределено
//    * ГруппаДоступа    - СправочникСсылка.ГруппыДоступа, Неопределено
//    * Пользователь     - СправочникСсылка.Пользователи, Неопределено
//    * ТолькоИзменение  - Булево - если Истина, оставлять только роли с правом Изменение
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ЦепочкаПрав(Отборы) Экспорт
	
	ПроверитьОтборы(Отборы);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЦепочки();
	
	Запрос.УстановитьПараметр("ПраваРолейРасширений",
		УправлениеДоступомСлужебный.ПраваРолейРасширений());
	
	Запрос.УстановитьПараметр("ОтборОбъект", ЗначениеЗаполнено(Отборы.ОбъектМетаданных));
	Запрос.УстановитьПараметр("ОбъектМетаданных", Отборы.ОбъектМетаданных);
	
	Запрос.УстановитьПараметр("ОтборРоль", ЗначениеЗаполнено(Отборы.Роль));
	Запрос.УстановитьПараметр("Роль", Отборы.Роль);
	
	Запрос.УстановитьПараметр("ОтборПрофиль", ЗначениеЗаполнено(Отборы.Профиль));
	Запрос.УстановитьПараметр("Профиль", Отборы.Профиль);
	
	Запрос.УстановитьПараметр("ОтборГруппаДоступа", ЗначениеЗаполнено(Отборы.ГруппаДоступа));
	Запрос.УстановитьПараметр("ГруппаДоступа", Отборы.ГруппаДоступа);
	
	Запрос.УстановитьПараметр("ОтборПользователь", ЗначениеЗаполнено(Отборы.Пользователь));
	Запрос.УстановитьПараметр("Пользователь", Отборы.Пользователь);
	
	Запрос.УстановитьПараметр("ТолькоИзменение", Отборы.ТолькоИзменение = Истина);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОтборы(Отборы)
	
	Если Не ЗначениеЗаполнено(Отборы.ОбъектМетаданных)
		И Не ЗначениеЗаполнено(Отборы.Пользователь) Тогда
		
		ВызватьИсключение
			"Укажите отбор по объекту метаданных и/или пользователю.
			|Полная выгрузка без отбора недопустима из‑за объёма данных.";
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаЦепочки()
	
	Возврат
	"ВЫБРАТЬ
	|	ПраваРолей.ОбъектМетаданных КАК ОбъектМетаданных,
	|	ПраваРолей.Роль КАК Роль,
	|	ПраваРолей.ПравоИзменение КАК ПравоИзменение,
	|	ПраваРолей.ПравоДобавление КАК ПравоДобавление,
	|	ПраваРолей.ПравоЧтениеБезОграничения КАК ПравоЧтениеБезОграничения,
	|	ПраваРолей.ПравоИзменениеБезОграничения КАК ПравоИзменениеБезОграничения,
	|	ПраваРолей.ПравоДобавлениеБезОграничения КАК ПравоДобавлениеБезОграничения,
	|	ПраваРолей.ПравоПросмотр КАК ПравоПросмотр,
	|	ПраваРолей.ПравоРедактирование КАК ПравоРедактирование,
	|	ПраваРолей.ПравоИнтерактивноеДобавление КАК ПравоИнтерактивноеДобавление,
	|	ПраваРолей.ВидИзмененияСтроки КАК ВидИзмененияСтроки
	|ПОМЕСТИТЬ ПраваРолейРасширений
	|ИЗ
	|	&ПраваРолейРасширений КАК ПраваРолей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПраваРолейРасширений.ОбъектМетаданных КАК ОбъектМетаданных,
	|	ПраваРолейРасширений.Роль КАК Роль,
	|	ИСТИНА КАК ПравоЧтение,
	|	ПраваРолейРасширений.ПравоИзменение КАК ПравоИзменение,
	|	ПраваРолейРасширений.ПравоДобавление КАК ПравоДобавление,
	|	ПраваРолейРасширений.ПравоЧтениеБезОграничения КАК ПравоЧтениеБезОграничения,
	|	ПраваРолейРасширений.ПравоИзменениеБезОграничения КАК ПравоИзменениеБезОграничения,
	|	ПраваРолейРасширений.ПравоДобавлениеБезОграничения КАК ПравоДобавлениеБезОграничения,
	|	ПраваРолейРасширений.ПравоПросмотр КАК ПравоПросмотр,
	|	ПраваРолейРасширений.ПравоРедактирование КАК ПравоРедактирование,
	|	ПраваРолейРасширений.ПравоИнтерактивноеДобавление КАК ПравоИнтерактивноеДобавление
	|ПОМЕСТИТЬ ПраваРолей
	|ИЗ
	|	ПраваРолейРасширений КАК ПраваРолейРасширений
	|ГДЕ
	|	ПраваРолейРасширений.ВидИзмененияСтроки = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПраваРолей.ОбъектМетаданных,
	|	ПраваРолей.Роль,
	|	ИСТИНА,
	|	ПраваРолей.ПравоИзменение,
	|	ПраваРолей.ПравоДобавление,
	|	ПраваРолей.ПравоЧтениеБезОграничения,
	|	ПраваРолей.ПравоИзменениеБезОграничения,
	|	ПраваРолей.ПравоДобавлениеБезОграничения,
	|	ПраваРолей.ПравоПросмотр,
	|	ПраваРолей.ПравоРедактирование,
	|	ПраваРолей.ПравоИнтерактивноеДобавление
	|ИЗ
	|	РегистрСведений.ПраваРолей КАК ПраваРолей
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПраваРолейРасширений КАК ПраваРолейРасширений
	|		ПО ПраваРолей.ОбъектМетаданных = ПраваРолейРасширений.ОбъектМетаданных
	|			И ПраваРолей.Роль = ПраваРолейРасширений.Роль
	|ГДЕ
	|	ПраваРолейРасширений.ОбъектМетаданных ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Роль,
	|	ОбъектМетаданных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПраваРолей.ОбъектМетаданных КАК ОбъектМетаданных,
	|	ЕСТЬNULL(ПраваРолей.ОбъектМетаданных.ПолноеИмя, """") КАК ОбъектПолноеИмя,
	|	ЕСТЬNULL(ПраваРолей.ОбъектМетаданных.Синоним, """") КАК ОбъектСиноним,
	|	ПраваРолей.Роль КАК Роль,
	|	ЕСТЬNULL(ПраваРолей.Роль.ПолноеИмя, """") КАК РольПолноеИмя,
	|	ЕСТЬNULL(ПраваРолей.Роль.Синоним, """") КАК РольСиноним,
	|	ПрофилиГруппДоступаРоли.Ссылка КАК Профиль,
	|	ГруппыДоступа.Ссылка КАК ГруппаДоступа,
	|	СоставыГруппПользователей.Пользователь КАК Пользователь,
	|	ПраваРолей.ПравоЧтение КАК ПравоЧтение,
	|	ПраваРолей.ПравоИзменение КАК ПравоИзменение,
	|	ПраваРолей.ПравоДобавление КАК ПравоДобавление,
	|	ПраваРолей.ПравоПросмотр КАК ПравоПросмотр,
	|	ПраваРолей.ПравоРедактирование КАК ПравоРедактирование,
	|	ПраваРолей.ПравоЧтениеБезОграничения КАК ПравоЧтениеБезОграничения,
	|	ПраваРолей.ПравоИзменениеБезОграничения КАК ПравоИзменениеБезОграничения
	|ИЗ
	|	ПраваРолей КАК ПраваРолей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
	|		ПО ПраваРолей.Роль = ПрофилиГруппДоступаРоли.Роль
	|			И (НЕ ПрофилиГруппДоступаРоли.Ссылка.ПометкаУдаления)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
	|		ПО (ГруппыДоступа.Профиль = ПрофилиГруппДоступаРоли.Ссылка)
	|			И (НЕ ГруппыДоступа.ПометкаУдаления)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК УчастникиГруппДоступа
	|		ПО (УчастникиГруппДоступа.Ссылка = ГруппыДоступа.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
	|		ПО (СоставыГруппПользователей.ГруппаПользователей = УчастникиГруппДоступа.Пользователь)
	|			И (ЕСТЬNULL(СоставыГруппПользователей.Пользователь.Служебный, ЛОЖЬ) <> ИСТИНА)
	|ГДЕ
	|	(НЕ &ОтборОбъект
	|			ИЛИ ПраваРолей.ОбъектМетаданных = &ОбъектМетаданных)
	|	И (НЕ &ОтборРоль
	|			ИЛИ ПраваРолей.Роль = &Роль)
	|	И (НЕ &ОтборПрофиль
	|			ИЛИ ПрофилиГруппДоступаРоли.Ссылка = &Профиль)
	|	И (НЕ &ОтборГруппаДоступа
	|			ИЛИ ГруппыДоступа.Ссылка = &ГруппаДоступа)
	|	И (НЕ &ОтборПользователь
	|			ИЛИ СоставыГруппПользователей.Пользователь = &Пользователь)
	|	И (НЕ &ТолькоИзменение
	|			ИЛИ ПраваРолей.ПравоИзменение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектПолноеИмя,
	|	РольПолноеИмя,
	|	Профиль,
	|	ГруппаДоступа,
	|	Пользователь";
	
КонецФункции

#КонецОбласти

#КонецЕсли
