
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьНадписьКоличества();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не ЗначениеЗаполнено(ОбъектМетаданных)
		И Не ЗначениеЗаполнено(Пользователь) Тогда
		
		ПоказатьПредупреждение(,
			"Укажите отбор по объекту метаданных и/или пользователю.
			|Полная выгрузка без отбора недопустима.");
		Возврат;
		
	КонецЕсли;
	
	СформироватьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультат(Команда)
	
	Цепочка.Очистить();
	ОбновитьНадписьКоличестваНаКлиенте();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()
	
	Отборы = Новый Структура;
	Отборы.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	Отборы.Вставить("Роль", Роль);
	Отборы.Вставить("Профиль", Профиль);
	Отборы.Вставить("ГруппаДоступа", ГруппаДоступа);
	Отборы.Вставить("Пользователь", Пользователь);
	Отборы.Вставить("ТолькоИзменение", ТолькоИзменение);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Таблица = ОбработкаОбъект.ЦепочкаПрав(Отборы);
	
	Цепочка.Загрузить(Таблица);
	ОбновитьНадписьКоличества();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьКоличества()
	
	Элементы.НадписьКоличество.Заголовок = "Строк: " + Формат(Цепочка.Количество(), "ЧГ=0");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьКоличестваНаКлиенте()
	
	Элементы.НадписьКоличество.Заголовок = "Строк: " + Формат(Цепочка.Количество(), "ЧГ=0");
	
КонецПроцедуры

#КонецОбласти
