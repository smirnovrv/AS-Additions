
&НаКлиенте
Процедура КомандаОК(Команда)
	Результат = Новый Структура();
	Результат.Вставить("Проект" 		, Этап);
	Результат.Вставить("СуммаДокумента"	, СуммаДокумента); 
	
	Закрыть(Результат);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
   	
	Если Параметры.Свойство("Этап") Тогда 
		 Этап = Параметры.Этап;
	КонецЕсли;
	
	Если Параметры.Свойство("СуммаДокумента") Тогда 
		 СуммаДокумента = Параметры.СуммаДокумента;
	КонецЕсли;
		 
КонецПроцедуры
