
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВидОперации) Тогда
		ВидОперации = Перечисления.АС_ВидыОперацийКорректировкиДолга.ПереносЗадолженности;
	КонецЕсли;
	
	Если Оплаты.Количество() = 0 Тогда
		Оплаты.Добавить();
		Оплаты.Добавить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидОперации <> Перечисления.АС_ВидыОперацийКорректировкиДолга.ПереносЗадолженности Тогда
		Возврат;
	КонецЕсли;
	
	Если Оплаты.Количество() < 2 Или Оплаты.Количество() % 2 <> 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(
			"Оплаты указываются парами: нечетная строка — сторно оплаты поставщика-дебитора, четная — перенос поставщику-кредитору.",
			ЭтотОбъект, "Оплаты", , Отказ);
	КонецЕсли;
	
	Индекс = 0;
	Пока Индекс < Оплаты.Количество() - 1 Цикл
		СтрокаИсточник = Оплаты[Индекс];
		СтрокаПриемник = Оплаты[Индекс + 1];
		Если СуммаПары(СтрокаИсточник, СтрокаПриемник) = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон("Не заполнена сумма переноса (строки %1 и %2).", СтрокаИсточник.НомерСтроки, СтрокаПриемник.НомерСтроки),
				ЭтотОбъект, "Оплаты[" + Формат(Индекс, "ЧГ=0") + "].Сумма", , Отказ);
		КонецЕсли;
		Индекс = Индекс + 2;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Набор = Движения.ИИТ_ДенежныеСредстваОбъектовСтроительства;
	Набор.Записывать = Истина;
	Набор.Очистить();
	
	Если Отказ Или ВидОперации <> Перечисления.АС_ВидыОперацийКорректировкиДолга.ПереносЗадолженности Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = 0;
	Пока Индекс < Оплаты.Количество() - 1 Цикл
		
		СтрокаИсточник = Оплаты[Индекс];
		СтрокаПриемник = Оплаты[Индекс + 1];
		СуммаПереноса = СуммаПары(СтрокаИсточник, СтрокаПриемник);
		Если СуммаПереноса = 0 Тогда
			Индекс = Индекс + 2;
			Продолжить;
		КонецЕсли;
		
		Счет = БанковскийСчетПереноса(Организация, СтрокаИсточник.Договор, СтрокаПриемник.Договор);
		Если Не ЗначениеЗаполнено(Счет) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон("Не найден банковский счет организации для отражения переноса в БДДС и МОРС (строки %1 и %2).",
					СтрокаИсточник.НомерСтроки, СтрокаПриемник.НомерСтроки),
				ЭтотОбъект, "Организация", , Отказ);
			Возврат;
		КонецЕсли;
		
		ДобавитьДвижениеСписания(Набор, -СуммаПереноса, СтрокаИсточник, Счет);
		ДобавитьДвижениеСписания(Набор, СуммаПереноса, СтрокаПриемник, Счет);
		Индекс = Индекс + 2;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СуммаПары(СтрокаИсточник, СтрокаПриемник)
	
	Если СтрокаИсточник.Сумма <> 0 Тогда
		Возврат СтрокаИсточник.Сумма;
	КонецЕсли;
	
	Возврат СтрокаПриемник.Сумма;
	
КонецФункции

Процедура ДобавитьДвижениеСписания(Набор, СуммаДвижения, СтрокаОплаты, БанковскийСчет)
	
	Движение = Набор.ДобавитьРасход();
	Движение.Период = Дата;
	Движение.БанковскийСчет = БанковскийСчет;
	Движение.ОбъектСтроительства = СтрокаОплаты.Объект;
	Движение.ЭтапСтроительства = СтрокаОплаты.Этап;
	Движение.СтатьяДДС = СтрокаОплаты.Статья;
	Движение.Сумма = СуммаДвижения;
	Движение.СуммаБДДС = СуммаДвижения;
	
КонецПроцедуры

Функция БанковскийСчетПереноса(ОрганизацияДокумента, ДоговорИсточник, ДоговорПриемник)
	
	Счет = БанковскийСчетДоговора(ДоговорИсточник);
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Счет = БанковскийСчетДоговора(ДоговорПриемник);
	КонецЕсли;
	Если ЗначениеЗаполнено(Счет) Тогда
		Возврат Счет;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БанковскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Организация
	|	И НЕ БанковскиеСчета.ПометкаУдаления
	|	И НЕ БанковскиеСчета.Закрыт";
	Запрос.УстановитьПараметр("Организация", ОрганизацияДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	
КонецФункции

Функция БанковскийСчетДоговора(Договор)
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;
	
	Счет = Договор.БанковскийСчет;
	Если ТипЗнч(Счет) = Тип("СправочникСсылка.БанковскиеСчета") И ЗначениеЗаполнено(Счет) Тогда
		Возврат Счет;
	КонецЕсли;
	
	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	
КонецФункции
