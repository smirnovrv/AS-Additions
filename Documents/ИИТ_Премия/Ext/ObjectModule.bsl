
&Вместо("ПередЗаписью")
Процедура АЛФ_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Не ЗначениеЗаполнено(Создал) Тогда
		Создал = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСоздания) Тогда
		ДатаСоздания = ТекущаяДата();
	КонецЕсли;

	СуммаДокумента = Сотрудники.Итог("Сумма");

	Если АЛФ_МожноИзменятьПроведенныеПремии() Тогда
		Возврат;
	КонецЕсли;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Отказ = Истина;
		Сообщить("Недостаточно прав для проведения документа ""Премия""");
		Возврат;
	КонецЕсли;

	ДокументПроведен = Проведен;
	Если Не ЭтоНовый() Тогда
		ДокументПроведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен");
	КонецЕсли;

	Если Не ДокументПроведен Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	Если ПометкаУдаления И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ПометкаУдаления") Тогда
		Сообщить("Недостаточно прав для пометки на удаление проведенной премии");
	Иначе
		Сообщить("Недостаточно прав для изменения проведенной премии");
	КонецЕсли;

КонецПроцедуры

Функция АЛФ_МожноИзменятьПроведенныеПремии()

	Возврат РольДоступна("ПолныеПрава") Или РольДоступна("ИИТ_УтверждениеПремий");

КонецФункции
