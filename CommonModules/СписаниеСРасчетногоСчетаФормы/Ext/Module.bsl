
&ИзменениеИКонтроль("ВидимостьГруппыСтраниц")
Функция АЛФ_ВидимостьГруппыСтраниц(ВидОперации)

#Вставка
	Возврат Истина;
#КонецВставки

	Возврат ВидОперации <> Перечисления.ВидыОперацийСписаниеДенежныхСредств.ПеречислениеПодотчетномуЛицу
	И ВидОперации <> Перечисления.ВидыОперацийСписаниеДенежныхСредств.ПеречислениеНалога
	И ВидОперации <> Перечисления.ВидыОперацийСписаниеДенежныхСредств.ЛичныеСредстваПредпринимателя
	И ВидОперации <> Перечисления.ВидыОперацийСписаниеДенежныхСредств.ВыдачаЗаймаРаботнику
	И ВидОперации <> Перечисления.ВидыОперацийСписаниеДенежныхСредств.КомиссияБанка;

КонецФункции

&После("УстановитьПараметрыВыбораДоговораСКонтрагентом")
Процедура АЛФ_УстановитьПараметрыВыбораДоговораСКонтрагентом(Форма)
	
	Элемент = Форма.Элементы.Найти("РасшифровкаПлатежаДоговорКонтрагента");
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АЛФ_ДобавитьПрочееВОтборВидовДоговора(Элемент);
	
КонецПроцедуры

Процедура АЛФ_ДобавитьПрочееВОтборВидовДоговора(Элемент)
	
	ИмяОтбора = "Отбор.ВидДоговораУХ";
	ВидПрочее = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.Прочее");
	ДопустимыеВиды = Новый Массив;
	ОтборНайден = Ложь;
	
	Для Каждого Параметр Из Элемент.ПараметрыВыбора Цикл
		Если Параметр.Имя <> ИмяОтбора Тогда
			Продолжить;
		КонецЕсли;
		ОтборНайден = Истина;
		Если ТипЗнч(Параметр.Значение) = Тип("ФиксированныйМассив")
			Или ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			Для Каждого ТекущийВид Из Параметр.Значение Цикл
				ДопустимыеВиды.Добавить(ТекущийВид);
			КонецЦикла;
		ИначеЕсли ЗначениеЗаполнено(Параметр.Значение) Тогда
			ДопустимыеВиды.Добавить(Параметр.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ОтборНайден Или ДопустимыеВиды.Количество() = 0 Или ДопустимыеВиды.Найти(ВидПрочее) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопустимыеВиды.Добавить(ВидПрочее);
	ФормыУХКлиентСервер.ДобавитьПараметрВыбора(Элемент, ИмяОтбора, Новый ФиксированныйМассив(ДопустимыеВиды));
	
КонецПроцедуры
