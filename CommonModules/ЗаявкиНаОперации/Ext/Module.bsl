
&После("УстановитьПараметрыВыбораДоговора")
Процедура АЛФ_УстановитьПараметрыВыбораДоговора(Форма)
	
	Объект = Форма.Объект;
	Если Не Объект.Свойство("ВидОперацииУХ") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объект.Ссылка) <> Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		Возврат;
	КонецЕсли;
	
	Если Строка(Объект.ВидОперацииУХ) <> "Перевод на счет другой организации" Тогда
		Возврат;
	КонецЕсли;
	
	ВидПрочее = ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.Прочее");
	ИменаЭлементов = АЛФ_ИменаЭлементовДоговора(Форма);
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		Элемент = Форма.Элементы.Найти(ИмяЭлемента);
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		АЛФ_ДобавитьВидДоговораВОтбор(Элемент, ВидПрочее);
	КонецЦикла;
	
КонецПроцедуры

Функция АЛФ_ИменаЭлементовДоговора(Форма)
	
	ИменаЭлементов = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "РеквизитыДокумента")
		И Форма.РеквизитыДокумента.Свойство("Параметры")
		И Форма.РеквизитыДокумента.Параметры.Свойство("Элементы") Тогда
		ИменаЭлементов = Форма.РеквизитыДокумента.Параметры.Элементы.Получить("ДоговорКонтрагента");
	КонецЕсли;
	
	Если ИменаЭлементов = Неопределено Тогда
		ИменаЭлементов = Новый Массив;
		ИменаЭлементов.Добавить("ДоговорКонтрагента");
	КонецЕсли;
	
	Возврат ИменаЭлементов;
	
КонецФункции

Процедура АЛФ_ДобавитьВидДоговораВОтбор(Элемент, ВидДоговора)
	
	ИмяОтбора = "Отбор.ВидДоговораУХ";
	ДопустимыеВиды = Новый Массив;
	ОтборНайден = Ложь;
	
	Для Каждого Параметр Из Элемент.ПараметрыВыбора Цикл
		Если Параметр.Имя <> ИмяОтбора Тогда
			Продолжить;
		КонецЕсли;
		ОтборНайден = Истина;
		Если ТипЗнч(Параметр.Значение) = Тип("ФиксированныйМассив")
			Или ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			Для Каждого ТекущийВид Из Параметр.Значение Цикл
				ДопустимыеВиды.Добавить(ТекущийВид);
			КонецЦикла;
		ИначеЕсли ЗначениеЗаполнено(Параметр.Значение) Тогда
			ДопустимыеВиды.Добавить(Параметр.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ОтборНайден Или ДопустимыеВиды.Найти(ВидДоговора) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопустимыеВиды.Добавить(ВидДоговора);
	ФормыУХКлиентСервер.ДобавитьПараметрВыбора(Элемент, ИмяОтбора, Новый ФиксированныйМассив(ДопустимыеВиды));
	
КонецПроцедуры
