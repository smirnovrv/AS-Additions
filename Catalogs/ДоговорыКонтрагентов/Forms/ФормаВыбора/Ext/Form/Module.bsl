
&НаСервере
&После("ПриСозданииНаСервере")
Процедура АЛФ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Владелец") И ЗначениеЗаполнено(Параметры.Отбор.Владелец) Тогда
		Возврат;
	КонецЕсли;
	
	Контрагент = АЛФ_КонтрагентИсточника();
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Отбор.Вставить("Владелец", Контрагент);
	ОтборыСписковКлиентСервер.УстановитьЭлементОтбораСписка(Список, "Владелец", Контрагент,
		ВидСравненияКомпоновкиДанных.Равно);
	ДоговорыКонтрагентовФормыУХ.УстановитьПредставлениеОтбораФормыВыбора(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Функция АЛФ_КонтрагентИсточника()
	
	Контрагент = Неопределено;
	Если Параметры.Отбор.Свойство("Контрагент") И ЗначениеЗаполнено(Параметры.Отбор.Контрагент) Тогда
		Контрагент = Параметры.Отбор.Контрагент;
		Параметры.Отбор.Удалить("Контрагент");
	ИначеЕсли Параметры.Свойство("АЛФ_КонтрагентИсточника") И ЗначениеЗаполнено(Параметры.АЛФ_КонтрагентИсточника) Тогда
		Контрагент = Параметры.АЛФ_КонтрагентИсточника;
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Организации") Тогда
		Контрагент = РаботаСКонтрагентамиУХ.КонтрагентОрганизации(Контрагент);
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Контрагент;
	
КонецФункции
