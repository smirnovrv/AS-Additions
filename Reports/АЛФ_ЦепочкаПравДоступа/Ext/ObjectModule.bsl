///////////////////////////////////////////////////////////////////////////////////////////////////////
// Отчёт АЛФ_ЦепочкаПравДоступа
//
// Назначение:
//   Построение цепочки «Объект метаданных → Роль → Профиль → Группа доступа → Пользователь».
//
// Источники данных (как в типовом отчёте «Анализ прав доступа» БСП):
//   1. РегистрСведений.ПраваРолей — объект ↔ роль (наличие строки = право «Чтение»).
//   2. УправлениеДоступомСлужебный.ПраваРолейРасширений() — права ролей расширений.
//   3. Справочник.ПрофилиГруппДоступа.Роли — роль ↔ профиль.
//   4. Справочник.ГруппыДоступа — группа ↔ профиль.
//   5. Справочник.ГруппыДоступа.Пользователи + РегистрСведений.СоставыГруппПользователей —
//      участники группы доступа с разворотом групп пользователей.
//
// Ограничения:
//   - Не анализирует RLS по значениям видов доступа (организации, проекты и т.п.).
//   - Не показывает права на отдельные реквизиты, команды, формы, отчёты без таблицы.
//   - Не учитывает полноправных пользователей без групп доступа (роль ПолныеПрава напрямую).
//   - Без отбора по объекту или пользователю формирование запрещено (объём данных огромен).
//
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НастройкиКомпоновщика = КомпоновщикНастроек.ПолучитьНастройки();
	Отборы = ОтборыИзНастроек(НастройкиКомпоновщика);
	ПроверитьОтборы(Отборы);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ЦепочкаПрав", ЦепочкаПрав(Отборы));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		СхемаКомпоновкиДанных, НастройкиКомпоновщика, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтборыИзНастроек(НастройкиКомпоновщика)
	
	Отборы = Новый Структура;
	
	// Отбор по объекту — список идентификаторов (подбор таблиц, как в «Анализе прав доступа»).
	ОбъектМетаданных = ОбъектыМетаданныхИзОтбораСКД(НастройкиКомпоновщика);
	Если ОбъектМетаданных.Количество() = 0 Тогда
		ОбъектМетаданных = СписокИдентификаторов(
			ЗначениеПараметраСписком(НастройкиКомпоновщика, "ОбъектМетаданных"));
	КонецЕсли;
	
	Отборы.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	Отборы.Вставить("Роль", СписокИдентификаторов(
		ЗначениеПараметраСписком(НастройкиКомпоновщика, "Роль")));
	Отборы.Вставить("Профиль", ЗначениеПараметра(НастройкиКомпоновщика, "Профиль"));
	Отборы.Вставить("ГруппаДоступа", ЗначениеПараметра(НастройкиКомпоновщика, "ГруппаДоступа"));
	Отборы.Вставить("Пользователь", ЗначениеПараметра(НастройкиКомпоновщика, "Пользователь"));
	
	ТолькоИзменение = ЗначениеПараметра(НастройкиКомпоновщика, "ТолькоИзменение");
	Отборы.Вставить("ТолькоИзменение", ТолькоИзменение = Истина);
	
	Возврат Отборы;
	
КонецФункции

Функция ЗначениеПараметра(НастройкиКомпоновщика, ИмяПараметра)
	
	ПараметрКомпоновки = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	Параметр = НастройкиКомпоновщика.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновки);
	Если Параметр = Неопределено Или Не Параметр.Использование Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПервыйЭлементЗначения(Параметр.Значение);
	
КонецФункции

Функция ЗначениеПараметраСписком(НастройкиКомпоновщика, ИмяПараметра)
	
	ПараметрКомпоновки = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	Параметр = НастройкиКомпоновщика.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновки);
	Если Параметр = Неопределено Или Не Параметр.Использование Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Параметр.Значение;
	
КонецФункции

Функция ПервыйЭлементЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значение[0].Значение;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значение[0];
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Приводит значение к ссылке идентификатора объекта метаданных.
// Поддерживает ссылку, полное имя (строка) и объект метаданных.
//
Функция НормализоватьОбъектМетаданных(Значение)
	
	Значение = ПервыйЭлементЗначения(Значение);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("СправочникСсылка.ИдентификаторыОбъектовМетаданных")
		Или ТипЗнч(Значение) = Тип("СправочникСсылка.ИдентификаторыОбъектовРасширений") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Значение, Ложь);
	КонецЕсли;
	
	Попытка
		Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Значение, Ложь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ОбъектыМетаданныхИзОтбораСКД(НастройкиКомпоновщика)
	
	ПолеОбъекта = Новый ПолеКомпоновкиДанных("ОбъектМетаданных");
	
	Для Каждого ЭлементОтбора Из НастройкиКомпоновщика.Отбор.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭлементОтбора.ЛевоеЗначение <> ПолеОбъекта Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат СписокИдентификаторов(ЭлементОтбора.ПравоеЗначение);
		
	КонецЦикла;
	
	Возврат Новый Массив;
	
КонецФункции

// Разворачивает ссылку, список или полное имя в массив идентификаторов объектов метаданных.
//
Функция СписокИдентификаторов(Значение)
	
	Результат = Новый Массив;
	ДобавитьИдентификаторы(Результат, Значение);
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьИдентификаторы(Результат, Значение)
	
	Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент Из Значение Цикл
			ДобавитьИдентификаторы(Результат, Элемент.Значение);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			ДобавитьИдентификаторы(Результат, Элемент);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Идентификатор = НормализоватьОбъектМетаданных(Значение);
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Результат.Добавить(Идентификатор);
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрСпискаИдентификаторов(Значения)
	
	Если Значения.Количество() > 0 Тогда
		Возврат Значения;
	КонецЕсли;
	
	ПустойСписок = Новый Массив;
	ПустойСписок.Добавить(Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка());
	Возврат ПустойСписок;
	
КонецФункции

Процедура ПроверитьОтборы(Отборы)
	
	Если Отборы.ОбъектМетаданных.Количество() = 0
		И Не ЗначениеЗаполнено(Отборы.Пользователь) Тогда
		
		ВызватьИсключение
			"Укажите отбор по объекту метаданных и/или пользователю.
			|Полная выгрузка без отбора недопустима из‑за объёма данных.";
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЦепочкаПрав(Отборы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЦепочки();
	
	Запрос.УстановитьПараметр("ПраваРолейРасширений",
		УправлениеДоступомСлужебный.ПраваРолейРасширений());
	
	Запрос.УстановитьПараметр("ОтборОбъект", Отборы.ОбъектМетаданных.Количество() > 0);
	Запрос.УстановитьПараметр("ОбъектМетаданных", ПараметрСпискаИдентификаторов(Отборы.ОбъектМетаданных));
	
	Запрос.УстановитьПараметр("ОтборРоль", Отборы.Роль.Количество() > 0);
	Запрос.УстановитьПараметр("Роль", ПараметрСпискаИдентификаторов(Отборы.Роль));
	
	Запрос.УстановитьПараметр("ОтборПрофиль", ЗначениеЗаполнено(Отборы.Профиль));
	Запрос.УстановитьПараметр("Профиль", Отборы.Профиль);
	
	Запрос.УстановитьПараметр("ОтборГруппаДоступа", ЗначениеЗаполнено(Отборы.ГруппаДоступа));
	Запрос.УстановитьПараметр("ГруппаДоступа", Отборы.ГруппаДоступа);
	
	Запрос.УстановитьПараметр("ОтборПользователь", ЗначениеЗаполнено(Отборы.Пользователь));
	Запрос.УстановитьПараметр("Пользователь", Отборы.Пользователь);
	
	Запрос.УстановитьПараметр("ТолькоИзменение", Отборы.ТолькоИзменение = Истина);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаЦепочки()
	
	Возврат
	"ВЫБРАТЬ
	|	ПраваРолей.ОбъектМетаданных КАК ОбъектМетаданных,
	|	ПраваРолей.Роль КАК Роль,
	|	ПраваРолей.ПравоИзменение КАК ПравоИзменение,
	|	ПраваРолей.ПравоДобавление КАК ПравоДобавление,
	|	ПраваРолей.ПравоЧтениеБезОграничения КАК ПравоЧтениеБезОграничения,
	|	ПраваРолей.ПравоИзменениеБезОграничения КАК ПравоИзменениеБезОграничения,
	|	ПраваРолей.ПравоДобавлениеБезОграничения КАК ПравоДобавлениеБезОграничения,
	|	ПраваРолей.ПравоПросмотр КАК ПравоПросмотр,
	|	ПраваРолей.ПравоРедактирование КАК ПравоРедактирование,
	|	ПраваРолей.ПравоИнтерактивноеДобавление КАК ПравоИнтерактивноеДобавление,
	|	ПраваРолей.ВидИзмененияСтроки КАК ВидИзмененияСтроки
	|ПОМЕСТИТЬ ПраваРолейРасширений
	|ИЗ
	|	&ПраваРолейРасширений КАК ПраваРолей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПраваРолейРасширений.ОбъектМетаданных КАК ОбъектМетаданных,
	|	ПраваРолейРасширений.Роль КАК Роль,
	|	ИСТИНА КАК ПравоЧтение,
	|	ПраваРолейРасширений.ПравоИзменение КАК ПравоИзменение,
	|	ПраваРолейРасширений.ПравоДобавление КАК ПравоДобавление,
	|	ПраваРолейРасширений.ПравоЧтениеБезОграничения КАК ПравоЧтениеБезОграничения,
	|	ПраваРолейРасширений.ПравоИзменениеБезОграничения КАК ПравоИзменениеБезОграничения,
	|	ПраваРолейРасширений.ПравоДобавлениеБезОграничения КАК ПравоДобавлениеБезОграничения,
	|	ПраваРолейРасширений.ПравоПросмотр КАК ПравоПросмотр,
	|	ПраваРолейРасширений.ПравоРедактирование КАК ПравоРедактирование,
	|	ПраваРолейРасширений.ПравоИнтерактивноеДобавление КАК ПравоИнтерактивноеДобавление
	|ПОМЕСТИТЬ ПраваРолей
	|ИЗ
	|	ПраваРолейРасширений КАК ПраваРолейРасширений
	|ГДЕ
	|	ПраваРолейРасширений.ВидИзмененияСтроки = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПраваРолей.ОбъектМетаданных,
	|	ПраваРолей.Роль,
	|	ИСТИНА,
	|	ПраваРолей.ПравоИзменение,
	|	ПраваРолей.ПравоДобавление,
	|	ПраваРолей.ПравоЧтениеБезОграничения,
	|	ПраваРолей.ПравоИзменениеБезОграничения,
	|	ПраваРолей.ПравоДобавлениеБезОграничения,
	|	ПраваРолей.ПравоПросмотр,
	|	ПраваРолей.ПравоРедактирование,
	|	ПраваРолей.ПравоИнтерактивноеДобавление
	|ИЗ
	|	РегистрСведений.ПраваРолей КАК ПраваРолей
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПраваРолейРасширений КАК ПраваРолейРасширений
	|		ПО ПраваРолей.ОбъектМетаданных = ПраваРолейРасширений.ОбъектМетаданных
	|			И ПраваРолей.Роль = ПраваРолейРасширений.Роль
	|ГДЕ
	|	ПраваРолейРасширений.ОбъектМетаданных ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Роль,
	|	ОбъектМетаданных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПраваРолей.ОбъектМетаданных КАК ОбъектМетаданных,
	|	ЕСТЬNULL(ПраваРолей.ОбъектМетаданных.ПолноеИмя, """") КАК ОбъектПолноеИмя,
	|	ЕСТЬNULL(ПраваРолей.ОбъектМетаданных.Синоним, """") КАК ОбъектСиноним,
	|	ПраваРолей.Роль КАК Роль,
	|	ЕСТЬNULL(ПраваРолей.Роль.ПолноеИмя, """") КАК РольПолноеИмя,
	|	ЕСТЬNULL(ПраваРолей.Роль.Синоним, """") КАК РольСиноним,
	|	ПрофилиГруппДоступаРоли.Ссылка КАК Профиль,
	|	ГруппыДоступа.Ссылка КАК ГруппаДоступа,
	|	СоставыГруппПользователей.Пользователь КАК Пользователь,
	|	ПраваРолей.ПравоЧтение КАК ПравоЧтение,
	|	ПраваРолей.ПравоИзменение КАК ПравоИзменение,
	|	ПраваРолей.ПравоДобавление КАК ПравоДобавление,
	|	ПраваРолей.ПравоПросмотр КАК ПравоПросмотр,
	|	ПраваРолей.ПравоРедактирование КАК ПравоРедактирование,
	|	ПраваРолей.ПравоЧтениеБезОграничения КАК ПравоЧтениеБезОграничения,
	|	ПраваРолей.ПравоИзменениеБезОграничения КАК ПравоИзменениеБезОграничения
	|ИЗ
	|	ПраваРолей КАК ПраваРолей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
	|		ПО ПраваРолей.Роль = ПрофилиГруппДоступаРоли.Роль
	|			И (НЕ ПрофилиГруппДоступаРоли.Ссылка.ПометкаУдаления)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
	|		ПО (ГруппыДоступа.Профиль = ПрофилиГруппДоступаРоли.Ссылка)
	|			И (НЕ ГруппыДоступа.ПометкаУдаления)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК УчастникиГруппДоступа
	|		ПО (УчастникиГруппДоступа.Ссылка = ГруппыДоступа.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
	|		ПО (СоставыГруппПользователей.ГруппаПользователей = УчастникиГруппДоступа.Пользователь)
	|			И (ЕСТЬNULL(СоставыГруппПользователей.Пользователь.Служебный, ЛОЖЬ) <> ИСТИНА)
	|ГДЕ
	|	(НЕ &ОтборОбъект
	|			ИЛИ ПраваРолей.ОбъектМетаданных В (&ОбъектМетаданных))
	|	И (НЕ &ОтборРоль
	|			ИЛИ ПраваРолей.Роль В (&Роль))
	|	И (НЕ &ОтборПрофиль
	|			ИЛИ ПрофилиГруппДоступаРоли.Ссылка = &Профиль)
	|	И (НЕ &ОтборГруппаДоступа
	|			ИЛИ ГруппыДоступа.Ссылка = &ГруппаДоступа)
	|	И (НЕ &ОтборПользователь
	|			ИЛИ СоставыГруппПользователей.Пользователь = &Пользователь)
	|	И (НЕ &ТолькоИзменение
	|			ИЛИ ПраваРолей.ПравоИзменение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектПолноеИмя,
	|	РольПолноеИмя,
	|	Профиль,
	|	ГруппаДоступа,
	|	Пользователь";
	
КонецФункции

#КонецОбласти

